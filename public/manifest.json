  ],
  "screenshots": [
    {
      "src": "/screenshots/desktop-1.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Главный интерфейс AI IDE"
    },
    {
      "src": "/screenshots/mobile-1.png", 
      "sizes": "375x812",
      "type": "image/png",
