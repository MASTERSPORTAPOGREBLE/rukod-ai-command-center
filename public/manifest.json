  "shortcuts": [
    {
      "name": "Новый проект",
      "short_name": "Проект",
      "description": "Создать новый проект",
      "url": "/?action=new-project",
      "icons": [{ "src": "/icons/new-project.png", "sizes": "96x96" }]
    },
    {
      "name": "ИИ Чат",
      "short_name": "Чат",
      "description": "Открыть чат с ИИ",
      "url": "/?action=ai-chat",
      "icons": [{ "src": "/icons/ai-chat.png", "sizes": "96x96" }]
    },
    {
      "name": "Генерация изображений",
